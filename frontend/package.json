{
  "name": "uniway-frontend",
  "version": "1.0.0",
  "description": "UniWay campus navigation app (Capacitor + TypeScript)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/main.ts --bundle --outfile=www/dist/app.js --format=esm --define:__API_BASE_URL__=\\\"http://10.0.2.2:4000\\\"",
    "watch": "esbuild src/main.ts --bundle --outfile=www/dist/app.js --format=esm --watch --servedir=www --define:__API_BASE_URL__=\\\"http://localhost:4000\\\""
  },
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
