{
  "name": "uniway-backend",
  "version": "1.0.0",
  "description": "UniWay campus navigation backend (Express + MongoDB)",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
